#version 330 compatibility
#define SKYCRAFT_REALM  // generated by native/tools/pack_lab_realm.py from ../shadow.fsh
#include "/lib/materials.glsl"

uniform sampler2D gtexture;

in vec2 texcoord;
in vec4 glcolor;
flat in int material;

/* RENDERTARGETS: 0 */
layout(location = 0) out vec4 shadowColor;

void main() {
    if (material == MAT_WATER) discard;  // light reaches the bed (caustics do the rest)
    vec4 c = texture(gtexture, texcoord) * glcolor;
    if (c.a < 0.1) discard;  // leaves and grass cast dappled shadows
    shadowColor = c;
}
