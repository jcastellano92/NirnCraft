# The native build's content hash (the caches' build fingerprint): SHA-256 over every native source and shader, in
# path order, folded to 64 bits; written to OUT as ATLAS_BUILD_HASH. Any change to the code that makes or reads the
# cached data (kernels, generator, grid, codec) changes it, so the self-baking cache, the horizon cache and the cold
# tier's generated records start fresh by themselves.
#   cmake -DROOT=<native dir> -DOUT=<header> -P buildhash.cmake
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/src/*.cpp" "${ROOT}/src/*.hpp" "${ROOT}/src/*.h" "${ROOT}/shaders/*.slang"
     "${ROOT}/include/*.h")
list(SORT files)
set(all "")
foreach(f IN LISTS files)
  file(SHA256 "${ROOT}/${f}" h)
  string(APPEND all "${f}:${h};")
endforeach()
string(SHA256 digest "${all}")
string(SUBSTRING "${digest}" 0 16 hex)
# The GENERATOR's hash (ATLAS_GEN_HASH), what the generation and bake caches are keyed by (gen-<fingerprint>/): only the
# files that make the cached data, not the render kernels (atlas_far.slang ...), vk_backend, the grid or the harness. The
# data the generator reads (the program, the map, the roads, the settlements, the tapes) and the seed are in the key
# already (the program, ingest, map and extra fingerprints; the world's seed directory). A file that is not in this
# list and does change what a cached chunk or far tile holds is a wrong key: the idle verifier (AtlasClientGen.verifyStep, the
# `verify{}` block of atlas_info) regenerates cached chunks and tiles and counts the mismatches. Per-stage fingerprints
# (ATLAS-GPU-LOOP step 7) would replace this one hash: one per stage, over that stage's kernel files and its data.
set(gen_files
  shaders/atlas_gen.slang shaders/atlas_page.slang shaders/atlas_map.slang shaders/atlas_exact.slang
  shaders/atlas_features.slang shaders/atlas_feat_math.slang shaders/atlas_overlays.slang shaders/atlas_overlays_roads.slang
  shaders/atlas_ovl_javamath.slang shaders/atlas_store.slang shaders/atlas_height.slang
  src/gen_engine.cpp src/gen_bake.cpp src/gen_bake.hpp src/features_engine.cpp src/overlays_engine.cpp
  src/height_engine.cpp src/gencache.cpp src/gencache.hpp src/sectionpack.hpp src/sectioncodec.hpp tools/spv_exact.cpp)
list(SORT gen_files)
set(gen_all "")
foreach(f IN LISTS gen_files)
  if(NOT EXISTS "${ROOT}/${f}")
    message(FATAL_ERROR "buildhash.cmake: ${f} (the generator's, in gen_files) is not there: renamed? fix the list")
  endif()
  # (line endings do not count: a checkout that only changed them must not drop the bake)
  file(READ "${ROOT}/${f}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  string(SHA256 gh "${content}")
  string(APPEND gen_all "${f}:${gh};")
endforeach()
string(SHA256 gen_digest "${gen_all}")
string(SUBSTRING "${gen_digest}" 0 16 gen_hex)
set(text "// generated by cmake/buildhash.cmake: the native sources' and shaders' content hash, and the generator's alone\n#pragma once\n#define ATLAS_BUILD_HASH 0x${hex}ull\n#define ATLAS_GEN_HASH 0x${gen_hex}ull\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
