  "scenes": {
    "whiterun_falls_legion": [
      [
        "legate",
        "The rebels are breaking! Hold the gate! Whiterun stands with the Empire!"
      ],
      [
        "balgruuf",
        "So be it. Whiterun has chosen. Gods help us all."
      ]
    ],
    "whiterun_falls_storm": [
      [
        "storm_officer",
        "The gate's down! For Skyrim! Whiterun is free!"
      ],
      [
        "balgruuf",
        "Enough. Whiterun yields. Tell Ulfric he has his city."
      ]
    ],
    "windhelm_falls": [
      [
        "narrator",
        "The Palace of the Kings is quiet. Ulfric Stormcloak kneels in his own throne room and does not ask for mercy."
      ],
      [
        "tullius",
        "It's over. Skyrim stays in the Empire. Make sure the soldiers know who won this for them."
      ]
    ],
    "solitude_falls": [
      [
        "narrator",
        "Castle Dour's gate falls in. General Tullius stands alone in his war room, sword drawn, his officers dead around him."
      ],
      [
        "ulfric",
        "It's done. Skyrim is ours. Sovngarde will sing of this day."
      ]
    ]
  },
  "quests": [
    {
      "id": "cw_legion_join",
      "title": "Joining the Legion",
      "faction": "imperial_legion",
      "start": "npc:rikke",
      "requires": [
        "!faction:stormcloaks",
        "!faction:imperial_legion"
      ],
      "offer": "I want to join the Legion.",
      "pitch": "Good. Before I sign you up: Fort Hraggstad has been taken over by bandits, and we need it back. Clear it out, and come back.",
      "desc": "Legate Rikke will enlist me in the Imperial Legion once I've cleared bandits out of Fort Hraggstad.",
      "objectives": [
        {
          "type": "go",
          "place": "fort_hraggstad",
          "text": "Travel to Fort Hraggstad"
        },
        {
          "type": "clear",
          "place": "fort_hraggstad",
          "text": "Clear the bandits out of Fort Hraggstad",
          "spawn": [
            {
              "type": "skycraft:bandit",
              "count": 4
            },
            {
              "type": "skycraft:bandit_chief",
              "count": 1
            }
          ]
        },
        {
          "type": "talk",
          "npc": "rikke",
          "text": "Report to Legate Rikke",
          "topic": "Fort Hraggstad is clear.",
          "reply": "Then raise your hand and swear it. Welcome to the Imperial Legion, soldier. Here's your kit. Don't get blood on the collar."
        }
      ],
      "rewards": {
        "gold": 150,
        "join": true,
        "flags": [
          "cw_legion"
        ]
      },
      "why": [
        "haafingar.L9.imperial_seat",
        "haafingar.L8.divines_temple"
      ]
    },
