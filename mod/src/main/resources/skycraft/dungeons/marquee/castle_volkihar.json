    "harkon_prophecy": {
      "title": "Scroll of the Crimson Eclipse",
      "author": "Court Chronicler",
      "pages": [
        "While the northern sea freezes round our rock, the court drinks from chalices older than Solitude arch and waits for the sun to bleed out."
      ]
    },
    "bloodstone_ledger": {
      "title": "Tally of the Thrall-Ships",
      "author": "Harbour Steward",
      "pages": [
        "Two sloops lured by the false beacon off Broken Oar; four casks brought up the jetty steps before dawn."
      ]
    },
    "valerica_journal": {
      "title": "Notes Behind the Ruined Tower",
      "author": "The Exiled Matron",
      "pages": [
        "Bone meal, finely ground moonstone, and purified void salts: the mortar in the boneyard still remembers the way out of this cold court."
      ]
    }
