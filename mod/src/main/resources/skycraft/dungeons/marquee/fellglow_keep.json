  "books": {
    "caller_notes": {
      "title": "The Caller Exchange Ledger",
      "author": "The Caller",
      "pages": [
        "Three Winterhold folios traded for six cages of test subjects. The College hoards what it refuses to read; under Fellglow stones we read by firelight."
      ]
    },
    "orthorn_plea": {
      "title": "Scratchings on a Cell Slate",
      "author": "An Apprentice",
      "pages": [
        "I carried the books out of the Arcanaeum because she promised me the third circle of conjuration. Instead I count the grates in the floor and listen to the wolves in the kennels."
      ]
    },
    "vivisection_log": {
      "title": "Notes on Bound Anatomy",
      "author": "Fellglow Circle",
      "pages": [
        "The flame atronach core cools within forty heartbeats once the sigil tether is severed, leaving only scorched ash and salt."
      ]
    }
  },
