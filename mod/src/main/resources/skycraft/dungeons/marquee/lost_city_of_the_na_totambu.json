 "books": {
  "street": {
   "title": "A Street Under the Sand",
   "author": "Hakim",
   "pages": [
    "I counted forty doors on the buried street before I stopped. Every one is shut from the inside.\n\nThe light comes from a single shaft above the court. Where it falls on the stone the carvings look freshly cut."
   ]
  },
  "amina": {
   "title": "Amina's Lament",
   "author": "Amina",
   "pages": [
    "They said the dunes would take the city one grain at a time. Instead they took it in a night, politely, like guests who knew the way.\n\nIf you free the king, say his name. If you bind him, say it anyway."
   ]
  }
