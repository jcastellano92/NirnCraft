      "title": "Maluril Valve Notes",
      "author": "Maluril",
      "pages": [
        "The bandits think the steam doors answer to pry-bars. One turn of the third manifold floods the upper gallery with scalding vapour and keeps my work quiet."
      ]
    },
    "gatekeeper_log": {
      "title": "Lift Counter Tablet",
      "author": "Chief Tonal Engineer",
      "pages": [
        "Seven great cages descend to the glowing cavern; the Pale shaft registers one extra counterweight on every third cycle."
      ]
    },
