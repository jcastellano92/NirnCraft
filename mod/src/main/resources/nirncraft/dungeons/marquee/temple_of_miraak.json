 "boss": {
  "id": "nirncraft:miraak|nirncraft:dragon_priest|minecraft:wither_skeleton",
  "name": "Miraak's Shade"
 },
 "books": {
  "page1": {
   "title": "The First Page",
   "author": "unknown",
   "pages": [
    "Read, and the stair beneath your feet will remember which way you were facing.\n\nThe temple is a book, and you are a page being turned."
   ]
  },
  "page2": {
   "title": "The Second Page",
   "author": "unknown",
   "pages": [
    "The ribs of the hall are the spine of a larger thing. Walk between them without touching.\n\nThe whispering is not a voice. It is the room reading you back."
   ]
  },
  "page3": {
   "title": "The Third Page",
   "author": "unknown",
   "pages": [
    "Close the book or take it. The page does not mind which. The reader does."
   ]
  },
  "whispers": {
   "title": "Brother Tavi's Account",
   "author": "Tavi",
   "pages": [
    "I came to copy the carvings and stayed to be copied. My handwriting has changed. My name, I am told, is still mine.\n\nIf you find the three pages, read them in order, and do not answer when it asks you anything."
   ]
  }
 },
