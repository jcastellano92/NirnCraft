    "synod_log": {
      "title": "Expedition Log: Focusing Crystal",
      "author": "Envoys of the Synod",
      "pages": [
        "Four of our company fell before we reached the boilery doors. The blind creatures in the vents have nested around the crystal conduits."
      ]
    },
    "oculory_calibration": {
      "title": "Star-Lens Alignment Tables",
      "author": "Master of the Dome",
      "pages": [
        "When the three brass mirrors catch the ceiling aperture, every locus of arcane pressure across the continent blooms in cold blue light."
      ]
    },
    "paratus_notes": {
      "title": "Marginalia on Thermal Drift",
      "author": "Researcher Paratus",
      "pages": [
        "Even a stray frost-cast shifts the bronze gearing by half a finger. The Eastmarch geothermal vents must be damped before the lens is turned."
      ]
    }
