 "books": {
  "scholar": {
   "title": "Rubbing-Book of Iannus Verrel",
   "author": "Iannus Verrel",
   "pages": [
    "Third day below the weir. The stairs go down past the first drowned gallery and the old bridges still bear a man's weight, if he keeps to the middle.\n\nEvery lamp in this place is lit. Nobody tends them. I have stopped asking why.",
    "I took rubbings of the plates by the first gate. Four columns of names, each cut with a different hand, and every one begins with the same sign: a drop of water over a flame.\n\nThe gate lamps answer to levers hidden beside the door-posts. Pull them in order: bridge, cistern, archive.",
    "The wardens do not wake while you keep to the lamplight. I have seen one stand in the dark of the lower cistern and not move for an hour.\n\nI am going on to the archive. If this book is found, the rest of my rubbings are in the chest by the stair. Give them to a scholar of the old tongue, and tell her I was careful."
   ]
  },
  "plates": {
   "title": "Ledger of the Sealed Names",
   "author": "unknown",
   "pages": [
    "Names are kept here, not bodies. Each plate is cut when a house is bound and is struck from the wall when its last child dies.",
    "Seven plates are blank. One has been scratched through from the side of the living, in a hand that is not Ayleid.",
    "To free a name, open the lamp-gate in the last antechamber and speak it to the Warden. To bind it, leave the plate where it hangs."
   ]
  },
  "sanctum": {
   "title": "The Warden's Charge",
   "author": "The Last Warden",
   "pages": [
    "I was set to keep the lamps lit and the names sealed. The city above went dark; I kept my charge.\n\nThere is no one left to relieve me. I stayed."
   ]
  }
 },
