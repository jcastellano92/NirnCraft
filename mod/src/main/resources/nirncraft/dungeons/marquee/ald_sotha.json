 "books": {
  "prayer1": {
   "title": "First Prayer",
   "author": "A pilgrim",
   "pages": [
    "Walk slowly. The stone remembers every foot that was too hasty.\n\nThe first shrine asks only that you bring your own light."
   ]
  },
  "prayer2": {
   "title": "Second Prayer",
   "author": "A pilgrim",
   "pages": [
    "Bear the water without cursing it. It was here before the road and will be here after.\n\nPass the second shrine with an open hand."
   ]
  },
  "prayer3": {
   "title": "Third Prayer",
   "author": "A pilgrim",
   "pages": [
    "What sleeps below was not locked away from you, but from its own wanting.\n\nSpeak softly at the third shrine and do not take what you cannot return."
   ]
  },
  "voice": {
   "title": "Words at the Votive Stone",
   "author": "unknown",
   "pages": [
    "Nobody built this place for armies. It was built for the long walk, and for the one who waits at the end of it to be thanked, not slain."
   ]
  }
 },
