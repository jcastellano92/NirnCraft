  "shout.skycraft.dragon.force": "§6§lFUS RO DAH!",
  "shout.skycraft.dragon.disarm": "§6§lZUN HAAL VIIK!",
  "shout.skycraft.dragon.ethereal": "§b§lFEIM ZII GRON!",
  "message.skycraft.dragon.mound_rises": "§cAlduin's voice rolls over the hills. The dead dragon stirs in its mound!",
  "dialogue.skycraft.dragon.dragon.greeting": "Drem... you have the Voice of a dovah.",
  "dialogue.skycraft.dragon.dragon.alduin.ask": "What does Alduin want?",
  "dialogue.skycraft.dragon.dragon.alduin.answer": "He is first-born of Akatosh. He raises the fallen dov and eats the souls of the dead.",
  "dialogue.skycraft.dragon.paarthurnax.greeting": "Drem Yol Lok. Greetings, wunduniik. I am Paarthurnax.",
  "dialogue.skycraft.dragon.paarthurnax.voice.ask": "Teach me about the Voice.",
  "dialogue.skycraft.dragon.paarthurnax.voice.answer": "The Thu'um is the voice of the dov. To speak a Word you must first understand it. Meditate on what you have learned.",
  "dialogue.skycraft.dragon.paarthurnax.alduin.ask": "How can Alduin be defeated?",
  "dialogue.skycraft.dragon.paarthurnax.alduin.answer": "Long ago the ancient Tongues cast him adrift on the currents of Time. He has returned, as was foretold. Only the Dovahkiin may stop him.",
  "dialogue.skycraft.dragon.paarthurnax.nature.ask": "Why do you not hunger for power like other dragons?",
  "dialogue.skycraft.dragon.paarthurnax.nature.answer": "What is better - to be born good, or to overcome your evil nature through great effort? Every day I must master it anew.",
  "dialogue.skycraft.dragon.paarthurnax.throat.ask": "What is this place?",
  "dialogue.skycraft.dragon.paarthurnax.throat.answer": "Monahven. The Throat of the World. Here time itself was broken, and here Alduin fell from it.",
  "dialogue.skycraft.dragon.odahviing.greeting": "Hahkun. You have me at a disadvantage, Dovahkiin.",
  "dialogue.skycraft.dragon.odahviing.yoke.ask": "Why should I free you?",
  "dialogue.skycraft.dragon.odahviing.yoke.answer": "Alduin's cowardice has made me question his fitness to rule. Free me, and I will tell you where he has fled.",
  "dialogue.skycraft.dragon.odahviing.alduin.ask": "Where is Alduin?",
  "dialogue.skycraft.dragon.odahviing.alduin.answer": "Skuldafn, his ancient temple in the mountains. Only one who flies may reach it.",
  "dialogue.skycraft.silt_strider.greeting": "The great silt strider shifts its weight. Its caravaner calls: \"Where to, outlander?\"",
  "dialogue.skycraft.silt_strider.destination": "Travel to %s (%s septims)",
  "dialogue.skycraft.silt_strider.no_gold": "You need %s septims for the fare.",
  "dialogue.skycraft.silt_strider.arrived": "The silt strider sets you down at %s.",
