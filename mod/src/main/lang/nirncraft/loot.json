  "collectible.nirncraft.treasures_valenwood.graht_oak_heartseed.desc": "The seed of a walking city. It is warm, like something living.",
  "collectible.nirncraft.treasures_valenwood.wild_hunt_mask": "Wild Hunt Mask",
  "collectible.nirncraft.treasures_valenwood.wild_hunt_mask.desc": "A beast-mask from the Wild Hunt. Best not worn.",
  "collectible.nirncraft.treasures_valenwood.spinner_quill": "Spinner's Quill",
  "collectible.nirncraft.treasures_valenwood.spinner_quill.desc": "A quill used by a Spinner to weave the Bosmer's stories.",
  "collectible.nirncraft.treasures_valenwood.jaqspur_horn": "Jaqspur Horn",
  "collectible.nirncraft.treasures_valenwood.jaqspur_horn.desc": "A hunting horn of the archer-scouts of the Jaqspur.",
  "collection.nirncraft.treasures_summerset": "Psijic Relics of the Summerset Isles",
  "collection.nirncraft.treasures_summerset.desc": "Treasures of the Altmer and the mysterious Psijic Order. Found in that province's chests and hoards.",
  "collection.nirncraft.treasures_summerset.reward": "1,500 gold and a perk point",
  "collectible.nirncraft.treasures_summerset.psijic_sigil": "Psijic Sigil",
  "collectible.nirncraft.treasures_summerset.psijic_sigil.desc": "A token of the Order. It is never quite where you left it.",
  "collectible.nirncraft.treasures_summerset.crystal_tower_shard": "Crystal Tower Shard",
  "collectible.nirncraft.treasures_summerset.crystal_tower_shard.desc": "A shard of the tower that stands for Summerset in the world.",
  "collectible.nirncraft.treasures_summerset.aldmeri_scroll_case": "Aldmeri Scroll Case",
  "collectible.nirncraft.treasures_summerset.aldmeri_scroll_case.desc": "A case of moonstone and gold for an archivist's scrolls.",
  "collectible.nirncraft.treasures_summerset.sapiarch_lens": "Sapiarch's Lens",
  "collectible.nirncraft.treasures_summerset.sapiarch_lens.desc": "A lens ground by the scholars of Alinor; through it, letters glow.",
  "collectible.nirncraft.treasures_summerset.merethic_coin": "Merethic-era Coin",
  "collectible.nirncraft.treasures_summerset.merethic_coin.desc": "A coin older than any empire of men.",
