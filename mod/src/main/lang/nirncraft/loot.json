  "collectible.nirncraft.treasures_elsweyr.lunar_lattice_plate.desc": "A silver plate engraved with the dance of Masser and Secunda.",
  "collectible.nirncraft.treasures_elsweyr.mane_prayer_beads": "Mane's Prayer Beads",
  "collectible.nirncraft.treasures_elsweyr.mane_prayer_beads.desc": "Beads once blessed by a Mane of the Khajiit.",
  "collectible.nirncraft.treasures_elsweyr.sugar_censer": "Sugar Censer",
  "collectible.nirncraft.treasures_elsweyr.sugar_censer.desc": "A brass censer for burning sweet offerings to the moons.",
