  "unique.nirncraft.the_pale_blade": "The Pale Blade",
  "unique.nirncraft.the_pale_blade.lore": "Frost walks with it; the dead of the Pale salute it.",
  "unique.nirncraft.kahvozeins_fang": "Kahvozein's Fang",
