  "collectible.nirncraft.treasures_black_marsh.xanmeer_glyph_tablet": "Xanmeer Glyph Tablet",
  "collectible.nirncraft.treasures_black_marsh.xanmeer_glyph_tablet.desc": "A stone tablet from a stepped pyramid, carved in a forgotten script.",
