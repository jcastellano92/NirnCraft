  "collection.nirncraft.treasures_morrowind.reward": "1,500 gold and a perk point",
  "collectible.nirncraft.treasures_morrowind.ash_statue": "Ash Statue",
  "collectible.nirncraft.treasures_morrowind.ash_statue.desc": "A figure of packed ash. The Sixth House left many; few dare keep one.",
  "collectible.nirncraft.treasures_morrowind.velothi_reliquary": "Velothi Reliquary",
  "collectible.nirncraft.treasures_morrowind.velothi_reliquary.desc": "A small shrine-box for an ancestor's bones, beautifully worked.",
  "collectible.nirncraft.treasures_morrowind.kwama_queen_pearl": "Pearl of a Kwama Queen",
  "collectible.nirncraft.treasures_morrowind.kwama_queen_pearl.desc": "Rare, white, and smelling faintly of egg mine.",
  "collectible.nirncraft.treasures_morrowind.tribunal_icon": "Tribunal Icon",
