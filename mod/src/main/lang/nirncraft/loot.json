  "collectible.nirncraft.elder_scrolls.blood": "Elder Scroll (Blood)",
  "collectible.nirncraft.elder_scrolls.blood.desc": "It speaks of a prophecy written in the blood of a vampire lord's daughter.",
  "collectible.nirncraft.elder_scrolls.sun": "Elder Scroll (Sun)",
  "collectible.nirncraft.elder_scrolls.sun.desc": "It glows faintly, warm as a summer morning, and speaks of Auri-El's light.",
  "collection.nirncraft.treasures_skyrim": "Dwemer Artefacts of Skyrim",
