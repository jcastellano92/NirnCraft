  "unique.nirncraft.bloodthorn": "Bloodthorn",
  "unique.nirncraft.bloodthorn.lore": "A witch's dagger, grown more than forged.",
  "unique.nirncraft.bolars_oathblade": "Bolar's Oathblade",
  "unique.nirncraft.bolars_oathblade.lore": "Sworn on, and never broken.",
  "unique.nirncraft.nettlebane": "Nettlebane",
  "unique.nirncraft.nettlebane.lore": "Hagravens fear it; their thorns fear it more.",
  "unique.nirncraft.gauldur_blackblade": "Gauldur Blackblade",
  "unique.nirncraft.gauldur_blackblade.lore": "Forged for a son who betrayed his father, and buried with him.",
