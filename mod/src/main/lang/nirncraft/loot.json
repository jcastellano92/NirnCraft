  "collectible.nirncraft.treasures_skyrim.dwemer_lexicon": "Dwemer Lexicon",
  "collectible.nirncraft.treasures_skyrim.dwemer_lexicon.desc": "A cube of tonal inscriptions; it hums when held near a Dwemer lock.",
  "collectible.nirncraft.treasures_skyrim.aetherium_shard": "Aetherium Shard",
  "collectible.nirncraft.treasures_skyrim.aetherium_shard.desc": "A sliver of blue crystal that glows with its own light.",
