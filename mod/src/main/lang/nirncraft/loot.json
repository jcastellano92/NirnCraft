  "collectible.nirncraft.treasures_cyrodiil.great_welkynd_stone": "Great Welkynd Stone",
  "collectible.nirncraft.treasures_cyrodiil.great_welkynd_stone.desc": "A great stone that once lit an Ayleid hall from its ceiling.",
  "collectible.nirncraft.treasures_cyrodiil.varla_stone": "Varla Stone",
  "collectible.nirncraft.treasures_cyrodiil.varla_stone.desc": "A star-shaped stone of raw power, hidden by the Ayleids in their deepest vaults.",
