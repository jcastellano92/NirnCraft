  "collection.nirncraft.dragon_priest_masks": "Dragon Priest Masks",
  "collection.nirncraft.dragon_priest_masks.desc": "The eight masks of the Dragon Cult's priests, taken from their guardians in Skyrim's barrows. Bring them together and the ninth, Konahrik's, answers.",
  "collection.nirncraft.dragon_priest_masks.reward": "Konahrik's golden mask and a perk point",
  "collection.nirncraft.daedric_artifacts": "Daedric Artifacts",
  "collection.nirncraft.daedric_artifacts.desc": "Each Daedric Prince keeps a gift for a mortal worthy of it, waiting at their shrines across Tamriel. Prove your worth (and your level) to claim it.",
  "collection.nirncraft.daedric_artifacts.reward": "2,500 gold and two perk points",
  "collection.nirncraft.artifacts_of_legend": "Artifacts of Legend",
  "collection.nirncraft.artifacts_of_legend.desc": "Weapons from Skyrim's songs: Wuuthrad in Ysgramor's Tomb, the Staff of Magnus beneath Labyrinthian, Auriel's Bow beyond Darkfall Cave... and a few that turn up only in the deepest hoards.",
  "collection.nirncraft.artifacts_of_legend.reward": "2,000 gold and two perk points",
  "collection.nirncraft.stones_of_barenziah": "Stones of Barenziah",
  "collection.nirncraft.stones_of_barenziah.desc": "Twenty-four unusual gems pried from Queen Barenziah's crown, scattered across Skyrim's dungeons. The Journal names the place each one is hidden.",
  "collection.nirncraft.stones_of_barenziah.reward": "The Crown of Barenziah, 1,000 gold and a perk point; more gems in every hoard",
  "collection.nirncraft.black_books": "Black Books",
  "collection.nirncraft.black_books.desc": "Seven books of Hermaeus Mora hidden in Solstheim's ruins. Each one read teaches a secret: a perk point and two levels of its skill.",
  "collection.nirncraft.black_books.reward": "Two more perk points",
  "collection.nirncraft.elder_scrolls": "Elder Scrolls",
  "collection.nirncraft.elder_scrolls.desc": "Fragments of creation itself: the Dragon scroll in Blackreach's Tower of Mzark, the Blood scroll in Dimhollow Crypt, the Sun scroll beyond Darkfall Cave.",
  "collection.nirncraft.elder_scrolls.reward": "Two perk points",
  "collection.nirncraft.skill_books": "Skill Books",
  "collection.nirncraft.skill_books.desc": "Five books for every skill. Each teaches one level the first time it is read; reading all five of a skill teaches one more.",
  "collection.nirncraft.skill_books.reward": "Three perk points",
  "collection.nirncraft.legendary_uniques": "Legendary Arms",
  "collection.nirncraft.legendary_uniques.desc": "One-of-a-kind weapons of every province, waiting in named dungeons, forgotten camps and the treasure of their province's bosses.",
  "collection.nirncraft.legendary_uniques.reward": "10,000 gold and three perk points",
