  "collectible.nirncraft.treasures_high_rock.direnni_crest.desc": "The sigil of the Elven clan that once ruled High Rock.",
  "collectible.nirncraft.treasures_high_rock.coven_poppet": "Coven Poppet",
  "collectible.nirncraft.treasures_high_rock.coven_poppet.desc": "A witch's doll. Its stitching is far too neat.",
  "collectible.nirncraft.treasures_high_rock.wyrd_tree_acorn": "Wyrd-Tree Acorn",
  "collectible.nirncraft.treasures_high_rock.wyrd_tree_acorn.desc": "From a sacred tree of the Wyrd; it sprouts in no soil you own.",
