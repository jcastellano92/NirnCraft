  "unique.nirncraft.welkynd_sliver": "Welkynd Sliver",
  "unique.nirncraft.welkynd_sliver.lore": "An Ayleid dagger set with a sliver of starlight.",
  "unique.nirncraft.goldbrand": "Goldbrand",
