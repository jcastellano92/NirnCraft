  "collectible.nirncraft.treasures_hammerfell.ansei_ward.desc": "A Sword-Singer's ward against the dead.",
  "collectible.nirncraft.treasures_hammerfell.satakal_figurine": "Satakal Figurine",
  "collectible.nirncraft.treasures_hammerfell.satakal_figurine.desc": "The snake that eats itself, carved in black stone.",
  "collectible.nirncraft.treasures_hammerfell.alikr_sandglass": "Alik'r Sandglass",
  "collectible.nirncraft.treasures_hammerfell.alikr_sandglass.desc": "Its sand runs upward at dawn, the nomads say.",
  "collection.nirncraft.treasures_high_rock": "Treasures of High Rock",
