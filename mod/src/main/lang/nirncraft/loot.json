  "unique.nirncraft.umbra": "Umbra",
  "unique.nirncraft.umbra.lore": "The sword whispers, and those it kills are never quite gone.",
  "unique.nirncraft.hopesfire": "Hopesfire",
  "unique.nirncraft.hopesfire.lore": "Twin of Trueflame, made to bring light into dark places.",
  "unique.nirncraft.trueflame": "Trueflame",
  "unique.nirncraft.trueflame.lore": "The blade of a Dunmer hero, rekindled in the ash.",
