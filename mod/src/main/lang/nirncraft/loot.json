  "collectible.nirncraft.treasures_black_marsh.hist_sap_idol.desc": "A figure carved from a Hist's root, sticky to the touch.",
  "collectible.nirncraft.treasures_black_marsh.lizard_king_scale": "Scale of the Lizard Kings",
  "collectible.nirncraft.treasures_black_marsh.lizard_king_scale.desc": "A gilded scale once worn by a ruler of the old marsh.",
  "collectible.nirncraft.treasures_black_marsh.swamp_root_charm": "Swamp-Root Charm",
  "collectible.nirncraft.treasures_black_marsh.swamp_root_charm.desc": "Woven roots and bones; the Saxhleel tie them over doorways.",
  "collection.nirncraft.treasures_elsweyr": "Lunar Treasures of Elsweyr",
