  "collectible.nirncraft.treasures_hammerfell.yokudan_sword_hilt.desc": "The hilt of an ancient blade, wrapped in sharkskin.",
  "collectible.nirncraft.treasures_hammerfell.shehai_shard": "Shehai Shard",
