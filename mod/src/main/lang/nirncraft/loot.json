  "collectible.nirncraft.treasures_high_rock.breton_signet.desc": "A signet ring of a house that has backed every side of every war.",
  "collectible.nirncraft.treasures_high_rock.orsinium_war_totem": "Orsinium War Totem",
  "collectible.nirncraft.treasures_high_rock.orsinium_war_totem.desc": "A carved Orc totem from a stronghold of Wrothgar.",
  "unique.nirncraft.red_eagles_fury": "Red Eagle's Fury",
