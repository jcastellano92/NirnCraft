  "collectible.nirncraft.treasures_morrowind.dwemer_coherer": "Dwemer Coherer",
  "collectible.nirncraft.treasures_morrowind.dwemer_coherer.desc": "An instrument for listening to something no one else can hear.",
  "collection.nirncraft.treasures_black_marsh": "Hist Relics of Black Marsh",
