{
  "suite": "checks",
  "description": "Non-visual checks (tier check): builds, validators, audits and unit suites, each a command with an exit code and optional metrics parsed from its output. {core} = the preview instance's installed core jar.",
  "defaults": {
    "tier": "check",
    "group": "-",
    "variants": [
      "check"
    ]
  },
  "scenes": [
    {
      "id": "check-build-wrapper",
      "title": "Build wrapper, real build-lock contention and worktree output isolation regressions",
      "tags": ["check:build-wrapper", "suite:harness", "check:tools"],
      "run": ["py", "-3", "-u", "-m", "unittest", "discover", "-v", "-s", "tools/dev", "-p", "test_process_guard.py", "-k", "build"],
      "inputs": ["tools/dev/build_263.py", "tools/dev/build_263.ps1", "tools/dev/process_guard.py", "tools/dev/test_process_guard.py"],
      "metrics": {"tests": "Ran (\\d+) tests?"},
      "timeout": 120
    },
    {
      "id": "check-agent-review",
      "title": "Independent Codex/Claude reviewer protocols and shared-queue adapter",
      "tags": ["check:agent-review", "suite:harness", "check:tools"],
      "run": ["py", "-3", "-m", "unittest", "discover", "-s", "tools/dev", "-p", "test_agent_review.py"],
      "inputs": ["tools/dev/agent_review.py", "tools/dev/agent_job.py", "tools/dev/agent_watch.py", "tools/dev/test_agent_review.py", "tools/harness/review.py", "docs/agents/visual-reviewer.md"],
      "metrics": {"tests": "Ran (\\d+) tests?"},
      "timeout": 120
    },
    {
      "id": "check-shaderpack-compile",
      "title": "Infinite ATLAS pack builds and every program stage compiles (glslang)",
      "tags": [
        "check:shaders",
        "suite:smoke"
      ],
      "run": [
        "py",
        "-3",
        "-I",
        "shaderpack/build_pack.py"
      ],
      "inputs": [
        "shaderpack/InfiniteATLAS",
        "shaderpack/build_pack.py"
      ],
      "metrics": {
        "stages": "(\\d+)/\\d+ program stages compile"
      },
      "timeout": 300
    },
    {
      "id": "check-scene-catalog",
      "title": "Harness scene catalog: ids unique, poses valid, places exist",
      "tags": [
        "check:catalog",
        "suite:catalog",
        "suite:harness",
        "suite:smoke"
      ],
      "run": [
        "py",
        "-3",
        "tools/harness/validate_scenes.py"
      ],
      "inputs": [
        "tools/harness"
      ],
      "metrics": {
        "scenes": "(\\d+) scenes"
      },
      "timeout": 120
    },
    {
      "id": "check-camera-planner",
      "title": "Offline camera planner runs on the exact terrain (Helgen, Whiterun, Riverwood)",
      "tags": [
        "check:cameras",
        "check:world"
      ],
      "run": [
        "py",
        "-3",
        "tools/harness/harness.py",
        "cameras",
        "atlas-helgen-aerial",
        "atlas-whiterun-aerial",
        "atlas-riverwood-aerial"
      ],
      "inputs": [
        "mod/src/main/java/com/nirncraft/qa",
        "mod/src/main/java/com/nirncraft/tamriel",
        "native/java/mod-integration/harness"
      ],
      "timeout": 1800
    },
    {
      "id": "check-validate-pack",
      "title": "Modpack validation against the installed core jar",
      "tags": [
        "check:pack"
      ],
      "run": [
        "py",
        "-3",
        "tools/validate_pack.py",
        "--core-jar",
        "{core}"
      ],
      "inputs": [
        "pack",
        "tools/validate_pack.py"
      ],
      "timeout": 600
    },
    {
      "id": "check-pack-tool-tests",
      "title": "Pack / instance / server packaging tool tests",
      "tags": [
        "check:pack"
      ],
      "run": [
        "py",
        "-3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools",
        "-p",
        "test_*.py"
      ],
      "inputs": [
        "tools",
        "pack"
      ],
      "metrics": {
        "tests": "Ran (\\d+) tests?"
      },
      "timeout": 900
    },
    {
      "id": "check-unit",
      "title": "Gradle build with every JUnit suite (mod logic, data, bake validation)",
      "tags": [
        "check:unit",
        "check:assets",
        "check:lang",
        "check:loot",
        "check:economy",
        "check:quests",
        "check:npcs",
        "check:spells",
        "check:dungeons",
        "check:towns",
        "check:interiors",
        "check:roads",
        "check:hydrology"
      ],
      "run": [
        "py",
        "-3",
        "tools/dev/build_263.py",
        "--offline",
        "build"
      ],
      "inputs": [
        "mod/src",
        "mod/build.gradle"
      ],
      "metrics": {
        "seconds_gradle": "BUILD SUCCESSFUL in (\\d+)"
      },
      "timeout": 3600
    },
    {
      "id": "check-native",
      "title": "Infinite ATLAS native library: build + every native suite (CPU reference, Vulkan, GL interop)",
      "tags": [
        "check:native",
        "suite:lab"
      ],
      "run": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "native/build.ps1"
      ],
      "inputs": [
        "native/src",
        "native/include",
        "native/tests",
        "native/shaders",
        "native/CMakeLists.txt"
      ],
      "timeout": 3600
    },
    {
      "id": "check-kernel-budget",
      "title": "Kernels within their budget (native/shaders/kernel_budget.json: SPIR-V size, statics, groupshared, struct-passing calls), and the shader lint's warnings",
      "tags": [
        "check:kernel-budget",
        "suite:lab"
      ],
      "run": [
        "powershell",
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference = 'Stop'; if (-not (Test-Path -LiteralPath native/build/Release/spv_budget.exe -PathType Leaf)) { Write-Output 'FAIL: spv_budget.exe missing; build native first'; exit 2 }; & native/build/Release/spv_budget.exe native/shaders/kernel_budget.json native/build/gen native/build/gen/spv_modules.txt; $r = $LASTEXITCODE; if ($r -ne 0) { exit $r }; py -3 native/tools/shader_lint.py; exit $LASTEXITCODE"
      ],
      "inputs": [
        "native/shaders",
        "native/tools/spv_budget.cpp",
        "native/tools/shader_lint.py"
      ],
      "fail_regex": "FAIL",
      "timeout": 120
    },
    {
      "id": "check-pbr-materials",
      "title": "PBR / material audit: material ids, labPBR map coverage and validity, misclassified blocks",
      "tags": [
        "check:pbr",
        "check:assets",
        "feature:materials"
      ],
      "run": [
        "py",
        "-3",
        "tools/harness/audits/pbr_audit.py"
      ],
      "inputs": [
        "mod/src/main/resources/assets/nirncraft/textures/block",
        "mod/src/main/resources/assets/nirncraft/blockstates",
        "shaderpack/InfiniteATLAS/shaders/block.properties"
      ],
      "metrics": {
        "classified": "material id \\d+ \\((\\d+)%\\)",
        "specular": "labPBR specular \\d+ \\((\\d+)%\\)",
        "normal": "normal \\d+ \\((\\d+)%\\)"
      },
      "timeout": 300
    },
    {
      "id": "check-contracts",
      "title": "Registration contracts: every item / weapon / armour / block / entity wired everywhere it must be (new gaps fail)",
      "tags": [
        "check:contracts",
        "check:assets",
        "check:unit",
        "suite:smoke"
      ],
      "run": [
        "py",
        "-3",
        "tools/harness/audits/contracts.py"
      ],
      "inputs": [
        "mod/src/main/resources",
        "mod/src/main/lang",
        "mod/src/main/java/com/nirncraft/crafting",
        "tools/harness/audits"
      ],
      "timeout": 600,
      "metrics": {
        "problems": "problems (\\d+) new"
      }
    },
    {
      "id": "check-hydrology",
      "title": "Rivers run downhill and end in the sea, a lake or a river; lakes, pits, runoff",
      "tags": [
        "check:hydrology",
        "feature:river"
      ],
      "run": [
        "py",
        "-3",
        "tools/harness/audits/hydrology_gate.py"
      ],
      "inputs": [
        "mod/src/main/resources/nirncraft/tamriel",
        "tools/worldgen"
      ],
      "timeout": 600,
      "metrics": {
        "problems": "problems (\\d+)"
      }
    },
    {
      "id": "check-spawn-rules",
      "title": "Region spawn tables valid",
      "tags": [
        "check:npcs",
        "check:world",
        "check:regions"
      ],
      "run": [
        "py",
        "-3",
        "tools/qa/spawn_audit.py"
      ],
      "inputs": [
        "mod/src/main/resources/nirncraft",
        "tools/qa/spawn_audit.py"
      ],
      "timeout": 600,
      "fail_regex": "^\\s*ERR\\b"
    },
    {
      "id": "check-player-flow",
      "title": "Regional player-flow metrics (27 FLW per land region)",
      "tags": [
        "check:world",
        "check:regions",
        "check:places"
      ],
      "run": [
        "py",
        "-3",
        "tools/qa/flow_gate.py"
      ],
      "inputs": [
        "mod/src/main/resources/nirncraft",
        "tools/qa/flow_gate.py",
        "tools/qa/flow_audit.py"
      ],
      "timeout": 900,
      "metrics": {
        "problems": "(\\d+) fail"
      }
    },
    {
      "id": "check-data",
      "title": "JSON parses, duplicate ids, quest index, guards, menus, inventory facade",
      "tags": [
        "check:world",
        "check:quests",
        "check:npcs",
        "check:assets",
        "suite:smoke"
      ],
      "run": [
        "py",
        "-3",
        "tools/qa/data_checks.py"
      ],
      "inputs": [
        "mod/src/main/resources/nirncraft",
        "mod/src/main/resources/data",
        "tools/qa/data_checks.py"
      ],
      "timeout": 600,
      "fail_regex": "^\\s*ERR\\b"
    },
    {
      "id": "check-asset-chain",
      "title": "Blockstate -> model -> texture chain resolves",
      "tags": [
        "check:assets"
      ],
      "run": [
        "py",
        "-3",
        "tools/qa/asset_audit.py",
        "--list",
        "30"
      ],
      "inputs": [
        "mod/src/main/resources/assets",
        "tools/qa/asset_audit.py"
      ],
      "timeout": 600,
      "fail_regex": "^\\s*ERR\\b"
    },
    {
      "id": "check-assets-items",
      "title": "Item assets: models, textures, lang for every item",
      "tags": [
        "check:assets",
        "check:contracts"
      ],
      "run": [
