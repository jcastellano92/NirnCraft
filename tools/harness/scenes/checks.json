      ],
      "inputs": [
        "mod/src/main/resources/nirncraft/tamriel",
        "mod/src/main/resources/nirncraft/worldplan",
        "tools/qa/roadplan_lint.py"
      ],
      "timeout": 600
    },
    {
      "id": "check-road-headroom",
      "title": "Road headroom under bridges and arches",
      "tags": [
        "check:roads"
      ],
      "run": [
        "py",
        "-3",
        "-m",
        "unittest",
        "tools.qa.test_road_headroom"
      ],
      "inputs": [
        "tools/qa/test_road_headroom.py",
        "mod/src/main/resources/nirncraft"
      ],
      "timeout": 600
    },
    {
      "id": "check-ecology",
      "title": "Creature diet / habitat / encounter library",
