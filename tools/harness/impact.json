{
 "description": "Changed files -> the tests they can affect (tags, prefix match) and the hot reload they need. First matching rule wins unless it says \"final\": false. Used by `harness.py run --changed [REF]`, `harness.py gate` (merge / push) and watch mode.",
 "rules": [
  {
   "paths": [
    "native/tools/atlas_truth*"
   ],
   "tags": [
    "check:atlas-truth"
   ],
   "reload": null,
   "final": false
  },
  {
   "paths": [
    "mod/src/main/java/com/nirncraft/loot/container/*",
    "mod/src/main/resources/assets/nirncraft/blockstates/container*",
    "mod/src/main/resources/data/nirncraft/loot_table/containers/*"
   ],
   "tags": [
    "suite:containers"
   ],
   "reload": null,
   "final": false
  },
  {
   "paths": [
    "mod/src/*",
    "mod/build.gradle"
   ],
   "tags": [
    "check:unit"
   ],
   "reload": null,
   "final": false,
   "why": "every change under mod/src runs the full build with all JUnit suites (check-unit): a stale test never merges"
  },
  {
   "paths": [
    "mod/src/main/resources/natives/*",
    "mod/src/main/java/com/nirncraft/atlas/AtlasNative.java",
