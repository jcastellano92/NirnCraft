.DS_Store
Thumbs.db
# Pack build outputs
dist/
*.args
__pycache__/
# Skycraft Core is a build output; packaging tools inject it into build copies of the pack
pack/mods/skycraft-core.jar

# Local game/server output and generated resolver reports (keep source assets and bakes tracked)
/mod/logs/
/mod/crash-reports/
/mod/screenshots/
/mod/saves/
/logs/
/crash-reports/
*.log
*.log.*
*.hprof
*.jfr
/tools/bake/out/
/pack/RESOLVE_REPORT.md

# Local release packages and patched/downloaded shader packs; release notes stay tracked
/releases/*.zip
/releases/*.jar
/releases/shaderpack/
/releases/stage-*/

# Local Python environments and analysis caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
*.pyo

# Claude Code agent worktrees
.claude/

# generated previews (large; regenerate with the tools)
tools/worldgen/preview_places*.png

# private reference data extracted from the owner's own game installs (facts only; never commit)
.reference/

# offline QA renders (large); small contact sheets are copied to docs/screens/
tools/qa/out/
